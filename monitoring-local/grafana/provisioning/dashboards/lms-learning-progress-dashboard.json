    {
      "id": 4,
      "type": "stat",
      "title": "[오류] 학습률 조회 에러율",
      "description": "학습률 조회 API의 4xx/5xx 비율입니다. 지연 문제가 아니라 인증/권한/서버 예외 문제인지 구분하기 위해 봅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/courses/{courseId}/users/learning-progress\",status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/courses/{courseId}/users/learning-progress\"}[1m])), 0.0001)) or vector(0)",
          "legendFormat": "에러율",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true
        }
      ]
    },
