        "x": 0,
        "y": 5
      },
      "id": 2,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "랭킹 서버 오류(5xx, 5분)",
      "description": "랭킹 요청 완료 로그 중 서버 오류만 집계합니다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
