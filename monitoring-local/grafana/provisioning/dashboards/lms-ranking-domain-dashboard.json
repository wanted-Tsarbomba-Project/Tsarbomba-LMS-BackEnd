          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"spring\"} |= \"event=request_completed\" |= \"/api/v1/rankings/\" |~ \"status=5..\" [5m]))",
          "queryType": "range"
        }
